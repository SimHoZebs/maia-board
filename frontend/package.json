{
  "name": "maia-board-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:bundle": "vite build",
    "build": "npm run typecheck && npm run build:bundle",
    "build:profiling": "tsc --noEmit && vite build --mode profiling --outDir dist-profiling",
    "test": "vitest run src",
    "test:browser:run": "playwright test",
    "test:browser": "MAIA_BUILD_DIR=dist-browser npm run build && npm run test:browser:run",
    "test:browser:strict": "NODE_ENV=development npm run test:browser",
    "test:perf": "MAIA_BUILD_DIR=dist-profiling npm run build:profiling && MAIA_BUILD_DIR=dist-profiling playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "chess.js": "^1.4.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
