    "@lichess-org/chessground": "10.1.0",
    "chess.js": "1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.2",
    "vite": "8.0.0",
    "vitest": "3.2.4"
  }
}
